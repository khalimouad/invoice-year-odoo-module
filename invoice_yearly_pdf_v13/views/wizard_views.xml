<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Invoice wizard ──────────────────────────────────────────────── -->
    <record id="view_wizard_invoice_yearly_pdf_form" model="ir.ui.view">
        <field name="name">wizard.invoice.yearly.pdf.form</field>
        <field name="model">wizard.invoice.yearly.pdf</field>
        <field name="arch" type="xml">
            <form string="Generate Yearly Invoice PDF">
                <group>
                    <group string="Filter">
                        <field name="year"/>
                        <field name="invoice_type"/>
                    </group>
                    <group string="Print Template">
                        <field name="report_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_pdf"
                            string="Generate &amp; Download (small)"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_generate_pdf_background"
                            string="Queue Generation (large / no timeout)"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_invoice_yearly_pdf" model="ir.actions.act_window">
        <field name="name">Generate Yearly Invoice PDF</field>
        <field name="res_model">wizard.invoice.yearly.pdf</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ── History list (download table) ──────────────────────────────── -->
    <record id="view_invoice_yearly_pdf_list" model="ir.ui.view">
        <field name="name">invoice.yearly.pdf.list</field>
        <field name="model">invoice.yearly.pdf</field>
        <field name="arch" type="xml">
            <tree string="Generated PDFs"
                  decoration-warning="is_stuck"
                  decoration-info="state == 'running' and not is_stuck"
                  decoration-danger="state == 'error'"
                  decoration-success="state == 'done'">
                <field name="is_stuck" invisible="1"/>
                <field name="name"/>
                <field name="year"/>
                <field name="invoice_type_filter"/>
                <field name="state"/>
                <field name="progress_pct" string="Progress"
                       widget="progressbar"
                       attrs="{'invisible': [('state', 'not in', ['running', 'done'])]}"/>
                <field name="processed_count" string="Done"
                       attrs="{'invisible': [('state', 'not in', ['running', 'done'])]}"/>
                <field name="total_count" string="Total"
                       attrs="{'invisible': [('state', 'not in', ['running', 'done'])]}"/>
                <field name="invoice_count" string="Merged"
                       attrs="{'invisible': [('state', '!=', 'done')]}"/>
                <field name="started_on" string="Started"/>
                <field name="generated_on" string="Finished"/>
                <field name="attachment_id" string="Download"
                       attrs="{'invisible': [('attachment_id', '=', False)]}"/>
            </tree>
        </field>
    </record>

    <record id="view_invoice_yearly_pdf_form" model="ir.ui.view">
        <field name="name">invoice.yearly.pdf.form</field>
        <field name="model">invoice.yearly.pdf</field>
        <field name="arch" type="xml">
            <form string="Generated PDF">
                <header>
                    <button name="action_generate"
                            string="Re-generate"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible': [('state', 'in', ('draft', 'running'))]}"/>
                    <button name="action_reset"
                            string="Reset"
                            type="object"
                            class="btn-warning"
                            attrs="{'invisible': [('state', 'not in', ('running', 'error'))]}"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,running,done,error"/>
                </header>
                <sheet>
                    <!-- Stuck warning banner -->
                    <div class="alert alert-warning"
                         attrs="{'invisible': [('is_stuck', '=', False)]}">
                        <strong>This job appears stuck.</strong>
                        The Odoo worker was likely killed by resource limits
                        (limit_time_cpu / limit_memory_hard). Click
                        <strong>Reset</strong> to clear it, then re-queue or
                        contact your system administrator to raise worker limits.
                    </div>
                    <field name="is_stuck" invisible="1"/>
                    <group>
                        <group string="Settings">
                            <field name="name"/>
                            <field name="year"/>
                            <field name="invoice_type_filter"/>
                            <field name="report_id"/>
                        </group>
                        <group string="Result">
                            <field name="invoice_count" string="Documents merged"/>
                            <field name="started_on"/>
                            <field name="generated_on"/>
                            <field name="attachment_id" string="Download PDF"
                                   attrs="{'invisible': [('attachment_id', '=', False)]}"/>
                        </group>
                    </group>
                    <group string="Progress"
                           attrs="{'invisible': [('state', 'not in', ['running', 'done'])]}">
                        <field name="progress_pct" widget="progressbar" nolabel="1" colspan="2"/>
                        <field name="processed_count" string="Processed"/>
                        <field name="total_count" string="Total"/>
                    </group>
                    <group string="Error / Notes"
                           attrs="{'invisible': [('error_message', '=', False)]}">
                        <field name="error_message" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_invoice_yearly_pdf" model="ir.actions.act_window">
        <field name="name">Generated PDFs History</field>
        <field name="res_model">invoice.yearly.pdf</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
